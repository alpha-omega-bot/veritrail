# Veritrail server configuration — copy to `.env` and fill in real values.
#
# `.env` is gitignored; this example file is not. NEVER put real secrets here.
# Every value below is a placeholder.

# ---- Transport -------------------------------------------------------------

PORT=8787
# Binds all interfaces by default so containers are reachable. Keep the service
# behind a TLS-terminating reverse proxy.
HOST=0.0.0.0

# Exact origins allowed to call the API from a browser, comma-separated.
# When unset, no CORS headers are sent at all (the console is served same-origin).
# VERITRAIL_CORS_ORIGINS=https://ops.example.com

# ---- Authentication (required) ---------------------------------------------
#
# The server REFUSES TO START without credentials. Supply either VERITRAIL_API_KEYS
# or the VERITRAIL_OIDC_* group below.
#
# Format, comma-separated, one entry per key:
#   id:actorId:secret:role1|role2[:scope1|scope2][;labels=key=value|key2=value2]
#
# Roles:  ingest | operator | admin
# Scopes: audit:read | permissions:read | spend:read | decisions:read |
#         evidence:read | vendor-risk:read | forensics:read | rollback:read |
#         rollback:execute
#
# Secrets must be at least 16 characters. Generate them with:
#   openssl rand -base64 32
#
# IMPORTANT: a key that declares roles but no scopes receives EVERY scope those
# roles allow, and an `admin` key bypasses role and scope checks entirely. List
# scopes explicitly on any key you intend to restrict.
#
# The console needs an operator key with the read scopes for the views in use, and
# an UNSCOPED key (no `labels=`) for /api/audit/summary and /api/audit/verify.
VERITRAIL_API_KEYS=console:operator-1:replace-with-a-32-byte-random-secret:operator:audit:read|spend:read|vendor-risk:read|forensics:read

# Development escape hatch. `true` starts the server with NO authentication on any
# route, including admin mutations and ledger ingest. Never set this in production.
# VERITRAIL_ALLOW_UNAUTHENTICATED=false

# ---- Durability ------------------------------------------------------------

# Path to the append-only JSONL ledger. WITHOUT THIS the ledger is kept in memory
# and every record is lost on restart.
VERITRAIL_LEDGER_FILE=./data/veritrail.ledger.jsonl

# Enables HMAC signing of ledger records. Without a signer, a fully recomputed
# chain is internally consistent, so wholesale rewrites are not detectable from
# the chain alone.
# VERITRAIL_SIGNER_SECRET=replace-with-a-32-byte-random-secret

# ---- Admin action signing (optional) ---------------------------------------
# Requires HMAC-signed requests for admin mutations. Requires auth credentials.
# VERITRAIL_ADMIN_ACTION_SIGNING_SECRET=replace-with-a-32-byte-random-secret
# VERITRAIL_ADMIN_ACTION_SIGNING_KEY_ID=admin-action
# VERITRAIL_ADMIN_ACTION_SIGNING_MAX_SKEW_MS=300000

# ---- OIDC (optional, alternative to API keys) ------------------------------
# issuer + audience + one of jwks / jwks_url / discovery_url are required together.
# Only RS256 is accepted.
# VERITRAIL_OIDC_ISSUER=https://idp.example.com/
# VERITRAIL_OIDC_AUDIENCE=veritrail-api
# VERITRAIL_OIDC_DISCOVERY_URL=https://idp.example.com/.well-known/openid-configuration
# VERITRAIL_OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# VERITRAIL_OIDC_JWKS_CACHE_TTL_MS=300000
# VERITRAIL_OIDC_ACTOR_CLAIM=sub
# VERITRAIL_OIDC_ROLES_CLAIM=roles
# VERITRAIL_OIDC_SCOPES_CLAIM=scope
# VERITRAIL_OIDC_LABEL_SCOPE_CLAIM=veritrail_labels
# VERITRAIL_OIDC_DEFAULT_ROLES=operator
# VERITRAIL_OIDC_DEFAULT_SCOPES=audit:read
# VERITRAIL_OIDC_ROLE_MAPPINGS=idp-admins=admin,idp-ops=operator
# VERITRAIL_OIDC_SCOPE_MAPPINGS=read:audit=audit:read
# VERITRAIL_OIDC_CLOCK_SKEW_SECONDS=60

# ---- Request limits (optional) ---------------------------------------------
# Malformed values are rejected at startup rather than silently defaulted.
# VERITRAIL_BODY_LIMIT_BYTES=1048576
# VERITRAIL_RATE_LIMIT_MAX=600          # `0` disables rate limiting entirely
# VERITRAIL_RATE_LIMIT_WINDOW_MS=60000
# VERITRAIL_MAX_IN_FLIGHT_WRITES=32     # `0` disables write backpressure

# ---- Console (dev only) ----------------------------------------------------
# Vite dev-server proxy target for /api/*. The console never reads an API token
# from the environment; operators supply it at runtime in the browser.
# VERITRAIL_API=http://localhost:8787

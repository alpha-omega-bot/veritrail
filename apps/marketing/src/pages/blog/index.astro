---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---
<Base
  title="Blog — Veritrail"
  description="Engineering and policy notes from the Veritrail team."
>
  <Nav />

  <main>
    <section class="hero">
      <div class="container">
        <h1>Blog</h1>
        <p class="lede">
          We're working on the first posts. In the meantime, follow along on our
          changelog inside the console.
        </p>
      </div>
    </section>

    <section class="empty">
      <div class="container">
        <div class="empty-card">
          <h2>Nothing here yet</h2>
          <p>
            Want to be notified when we publish?
            <a href="https://console.veritrail.io/signup">Create an account</a> —
            product updates are delivered through your console preferences.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .hero { padding: 4rem 0 1rem; background: linear-gradient(180deg, #f7faff 0%, #ffffff 100%); }
  .lede { font-size: 1.1rem; color: var(--fg-muted); max-width: 620px; margin-top: 1rem; }
  .empty { padding: 3rem 0 6rem; }
  .empty-card {
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    padding: 3rem 2rem;
    text-align: center;
    background: var(--bg-alt);
  }
  .empty-card h2 { margin: 0 0 0.5rem; }
  .empty-card p { color: var(--fg-muted); margin: 0; }
</style>

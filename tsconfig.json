{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Veritrail root typecheck (source-resolved)",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@veritrail/core": ["packages/core/src/index.ts"],
      "@veritrail/sdk": ["packages/sdk/src/index.ts"],
      "@veritrail/server": ["packages/server/src/index.ts"],
      "@veritrail/cli": ["packages/cli/src/index.ts"],
      "@veritrail/relational-store": ["packages/relational-store/src/index.ts"],
      "@veritrail/provider-signers": ["packages/provider-signers/src/index.ts"],
      "@veritrail/provider-monitors": ["packages/provider-monitors/src/index.ts"],
      "@veritrail/mcp-server": ["packages/mcp-server/src/index.ts"],
      "@veritrail/receipt": ["packages/receipt/src/index.ts"],
      "@veritrail/auto-rca": ["packages/auto-rca/src/index.ts"],
      "@veritrail/policy-simulator": ["packages/policy-simulator/src/index.ts"],
      "@veritrail/cost-optimizer": ["packages/cost-optimizer/src/index.ts"],
      "@veritrail/compliance": ["packages/compliance/src/index.ts"],
      "@veritrail/integrations": ["packages/integrations/src/index.ts"],
      "@veritrail/integrations-langchain": ["packages/integrations-langchain/src/index.ts"],
      "@veritrail/control-plane": ["packages/control-plane/src/index.ts"],
      "@veritrail/agent-reputation": ["packages/agent-reputation/src/index.ts"],
      "@veritrail/risk-network": ["packages/risk-network/src/index.ts"],
      "@veritrail/webhook-worker": ["packages/webhook-worker/src/index.ts"],
      "@veritrail/white-label": ["packages/white-label/src/index.ts"],
      "@veritrail/audit": ["packages/modules/audit/src/index.ts"],
      "@veritrail/permissions": ["packages/modules/permissions/src/index.ts"],
      "@veritrail/spend-guard": ["packages/modules/spend-guard/src/index.ts"],
      "@veritrail/rollback": ["packages/modules/rollback/src/index.ts"],
      "@veritrail/forensics": ["packages/modules/forensics/src/index.ts"],
      "@veritrail/evidence": ["packages/modules/evidence/src/index.ts"],
      "@veritrail/decision-memory": ["packages/modules/decision-memory/src/index.ts"],
      "@veritrail/vendor-risk": ["packages/modules/vendor-risk/src/index.ts"]
    }
  },
  "include": ["packages/**/src/**/*.ts", "packages/**/test/**/*.ts", "vitest.config.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**", "apps/**"]
}

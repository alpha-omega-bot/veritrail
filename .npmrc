# Veritrail pnpm configuration
# Strict, reproducible installs — trust starts with the supply chain.
engine-strict=true
# Disallow implicit access to non-declared dependencies (no phantom deps).
hoist=false
shamefully-hoist=false
# Surface peer-dependency problems instead of silently auto-installing.
auto-install-peers=true
strict-peer-dependencies=false
# Keep the lockfile authoritative.
prefer-frozen-lockfile=true
